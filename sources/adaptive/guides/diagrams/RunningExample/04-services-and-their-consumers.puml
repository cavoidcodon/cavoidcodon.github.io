@startuml
!include ../_style.puml
left to right direction
rectangle "CameraDriver" as CD
rectangle "CameraService" as CS
rectangle "Fusion" as FU
rectangle "Cockpit (remote)" as CK
rectangle "ObjectListService" as OL
rectangle "FusionLite" as FL
rectangle "Storage" as ST
rectangle "CalibrationDataService" as CAL
rectangle "CalibrationCheck" as CC
rectangle "CM: Signal-to-Service\ntranslation" as S2S
rectangle "VehicleDynamicsService" as VD
rectangle "PowerModeService" as PM
rectangle "SmControl" as SMC
rectangle "AdasStatusService" as AS
