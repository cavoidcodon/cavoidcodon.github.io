@startuml
!include ../_style.puml
left to right direction
rectangle "A daemon-based cluster,\nfor example UCM" as D
rectangle "Execution Management" as EM
rectangle "Log and Trace" as LT
rectangle "Registry" as REG
rectangle "Cryptography" as CRY
rectangle "Persistency" as PER
rectangle "Platform Health Management" as PHM
rectangle "Time Synchronization" as TS
