left to right direction
rectangle "ChassisECU (CAN)" as CH
rectangle "CentralGateway\n(PDU routing, SOME/IP-SD)" as GW
rectangle "CM on HPC:\nSignal-Based SOME/IP binding" as CM
rectangle "Fusion, FusionLite, SmControl" as APP
rectangle "SmControl" as SMC
rectangle "InstrumentCluster (CAN)" as IC
